# Gitignore for Project Planner

# Node.js
node_modules/
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE related files
.DS_Store
.idea/
.vscode/
*.iml
.history/
.local/

# Prisma
/server/prisma/dev.db
/server/prisma/*.sqlite
/server/prisma/*.db

# TypeScript
*.tsbuildinfo

# Next.js (if frontend uses it)
.next/

# Vite (if frontend uses it)
.vite/

# Compiled output for server
/server/dist/

# Test coverage
coverage/
.nyc_output/

# Other
*.tgz
.temp-ai-patch-*.patch
