{
  "name": "project-planner-server",
  "version": "1.0.0",
  "description": "Plain Node.js server for AI planner with authentication and Fastify v5",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "start:dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": ["fastify", "nodejs", "typescript", "auth", "ai-planner"],
  "author": "Eddie Villanueva",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.0.1",
    "@fastify/passport": "3.0.2",
    "@fastify/session": "11.1.0",
    "@prisma/client": "6.8.2",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.5.0",
    "fastify": "5.6.0",
    "jsonwebtoken": "9.0.2",
    "node-fetch": "2.7.0",
    "nodemailer": "6.9.14",
    "passport": "0.7.0",
    "passport-github2": "0.1.12",
    "passport-google-oauth20": "2.0.0",
    "simple-git": "3.28.0",
    "ts-node": "10.9.2",
    "uuid": "10.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "22.10.7",
    "@types/node-fetch": "2.6.12",
    "@types/nodemailer": "6.4.17",
    "@types/passport": "1.0.17",
    "@types/passport-github2": "1.2.9",
    "@types/passport-google-oauth20": "2.0.14",
    "@types/passport-jwt": "4.0.1",
    "@types/uuid": "10.0.0",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.2",
    "nodemon": "3.1.4",
    "prettier": "3.6.2",
    "prisma": "6.8.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
