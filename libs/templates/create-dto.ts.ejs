import {
  IsString,
  IsOptional,
  IsEmail,
  IsArray,
  IsBoolean,
  IsNumber,
  IsInt,
  IsDate,
  IsUUID,
  IsObject,
  IsPositive,
  IsDefined
} from 'class-validator';
import { Type } from 'class-transformer'; // Needed for @Type

<% 
  const imports = new Set();
  for (const rel of relations) {
    // Use targetModel (original model name) for generating import paths
    imports.add(rel.type);
  }
%>
<% for (const relName of Array.from(imports)) { %>
import { Create<%= relName %>Dto } from './create-<%= relName.charAt(0).toLowerCase() + relName.slice(1) %>.dto';
<% } %>

export class Create<%= className %>Dto {
  <% for (const field of fields) { %>
  <%- field.validators.join('\n  ') %>
  <%- field.name %><%- field.isOptional ? '?' : '' %>: <%- field.tsType %>;
  <% } %>
  <% for (const field of relations) { %>
  <%- field.isOptional ? '  @IsOptional()' : '' %>
  <% if (field.isList) { %>
  @IsArray()
  @ValidateNested({ each: true })
  @Type(() => Create<%= field.targetModel %>Dto)
  <%- field.name %><%- field.isOptional ? '?' : '' %>: <%- field.tsType %>;
  <% } else { %>
  @ValidateNested()
  @Type(() => Create<%= field.targetModel %>Dto)
  <%- field.name %><%- field.isOptional ? '?' : '' %>: <%- field.tsType %>;
  <% } %>
  <% } %>
  <% if (hasCreatedBy) { %>
  // createdBy and createdById are typically handled by the service and not directly exposed in CreateDto
  // createdById?: string;
  <% } %>
  <% if (hasSubmittedById) { %>
  // submittedById is typically handled by the service and not directly exposed in CreateDto
  // submittedById?: string;
  <% } %>
}
export class Pagination<%= className %>ResultDto {
  @ApiProperty({ type: [Create<%= className %>Dto] })
  items: Create<%= className %>Dto[];

  @ApiProperty()
  total: number;

  @ApiProperty()
  page: number;

  @ApiProperty()
  pageSize: number;

  @ApiProperty()
  totalPages: number;
}

export class Pagination<%= className %>QueryDto {
  @IsOptional()
  @Type(() => Number)
  @IsPositive()
  @ApiPropertyOptional({ default: 1 })
  page?: number = 1;

  @IsOptional()
  @Type(() => Number)
  @IsPositive()
  @ApiPropertyOptional({ default: 10 })
  pageSize?: number = 10;

<% fields
  .filter(field =>
    !['id', 'createdAt', 'updatedAt', 'createdById', 'deletedAt'].includes(field.name)
  )
  .forEach(field => { -%>
  @IsOptional()
  <% if (field.tsType === 'string') { %>
  @IsString()
  <% } else if (field.tsType === 'boolean') { %>
  @IsBoolean()
  <% } else if (field.tsType === 'number') { %>
  @Type(() => Number)
  @IsNumber()
  <% } else if (field.tsType === 'Date') { %>
  @Type(() => Date)
  @IsDate()
  <% } %>
  @ApiPropertyOptional({ description: 'Filter by <%= field.name %>' })
  <%= field.name %>?: <%= field.tsType %>;
<% }) %>


}