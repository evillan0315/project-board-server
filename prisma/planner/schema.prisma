// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LLMGenerationPlan {
  id                     String                    @id @default(uuid())
  title                  String
  summary                String?
  thoughtProcess         String?
  documentation          String?
  projectMetadata        ProjectMetadata
  generationParameters GenerationParameters
  modules                Module[]
  buildScripts           Json?
  changes                FileChange[]
  artifacts              Artifact[]
  provenance             Provenance
  ci                     CI?
  containerization       Containerization?
  security               Security?
  gitInstructions        String[]

  @@map("llm_generation_plans")
}

model ProjectMetadata {
  id            String    @id @default(uuid())
  name          String
  version       String
  language      String
  frameworks    String[]
  packageManager String?
  license       String?
  authors       String[]
  repository    String?
  createdAt     DateTime
  lastUpdated   DateTime?
  ciConfigured  Boolean?

  plan   LLMGenerationPlan @relation(fields: [planId], references: [id])
  planId String            @unique

  @@map("project_metadata")
}

model GenerationParameters {
  id          String  @id @default(uuid())
  model       String
  temperature Float
  maxTokens   Int
  prompt      String?
  seed        Int?
  stopSequences String[]
  metadata      Json?

  plan   LLMGenerationPlan @relation(fields: [planId], references: [id])
  planId String            @unique

  @@map("generation_parameters")
}

model Module {
  id           String   @id @default(uuid())
  name         String
  description  String
  dependencies Json?
  apiEndpoints Json?
  tests        Json?
  linting      Json?

  plan   LLMGenerationPlan @relation(fields: [planId], references: [id])
  planId String

  @@map("modules")
}

model FileChange {
  id        String @id @default(uuid())
  filePath  String
  action    FileAction
  newContent String?
  reason    String?
  encoding  String? // enum: ["utf-8", "base64"]
  checksum  String?
  sizeBytes Int?

  plan   LLMGenerationPlan @relation(fields: [planId], references: [id])
  planId String

  @@map("file_changes")
}

model Artifact {
  id        String @id @default(uuid())
  type      String // enum: ["docker-image", "archive", "binary", "sbom", "report", "container-image"]
  path      String
  sha256    String?
  sizeBytes Int?
  platform  String?
  metadata  Json?

  plan   LLMGenerationPlan @relation(fields: [planId], references: [id])
  planId String

  @@map("artifacts")
}

model Provenance {
  id          String   @id @default(uuid())
  generatedBy String
  generatedAt DateTime
  promptRef   String?
  commitHash  String?
  generationId String?
  humanReview Json?
  signatures Json?

  plan   LLMGenerationPlan @relation(fields: [planId], references: [id])
  planId String            @unique

  @@map("provenance")
}

model CI {
  id            String  @id @default(uuid())
  provider      String?
  pipelineRef   String?
  status        String? // enum: ["not-configured", "passing", "failing", "unknown"]
  requiredChecks String[]

  plan   LLMGenerationPlan @relation(fields: [planId], references: [id])
  planId String            @unique

  @@map("ci")
}

model Containerization {
  id              String  @id @default(uuid())
  dockerfilePath  String?
  imageName       String?
  baseImage       String?
  recommendedRuntime String?

  plan   LLMGenerationPlan @relation(fields: [planId], references: [id])
  planId String            @unique

  @@map("containerization")
}

model Security {
  id              String  @id @default(uuid())
  sbom            String?
  securityScans   Json?
  licenseCompliance Json?
  secretsHandling String?

  plan   LLMGenerationPlan @relation(fields: [planId], references: [id])
  planId String            @unique

  @@map("security")
}

enum FileAction {
  add
  modify
  delete
  repair
  analyze
}
