generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(uuid())
  email                  String              @unique
  username               String?
  emailVerified          DateTime?
  image                  String?
  name                   String?
  phone_number           String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime?           @updatedAt
  deletedAt              DateTime?
  role                   Role?
  passwordResetToken     String? // Stores the hashed password reset token
  passwordResetExpiresAt DateTime? // Stores the expiration time for the reset token
  Account                Account[]
  Database               Database[]
  Documentation          Documentation[]
  File                   File[]
  Folder                 Folder[]
  Form                   Form[]
  Module                 Module[]
  Organization           Organization[]
  password               Password?
  Project                Project[]
  Schema                 Schema[]
  Session                Session[]
  geminiRequests         GeminiRequest[]
  Recording              Recording[]
  SchemaSubmission       SchemaSubmission[]
  SystemInstruction      SystemInstruction[]
  terminalCommands       TerminalCommand[]
  commandHistory         CommandHistory[]
  playlists              Playlist[]
  terminalSessions       TerminalSession[]
  PlaylistMediaFile      PlaylistMediaFile[]

  // New relationships for music and video
  favoriteSongs      FavoriteSong[]
  favoriteVideos     FavoriteVideo[]
  musicHistories     MusicHistory[]
  videoHistories     VideoHistory[]
  Song               Song[]
  Video              Video[]
  Artist             Artist[]
  Album              Album[]
  Submission         Submission[]
  Metadata           Metadata[]
  LlmRequest         LlmRequest[]
  LlmResponse        LlmResponse[]
  ProposedFileChange ProposedFileChange[]
  ExecutionSnapshot  ExecutionSnapshot[]
  SchemaHistory      SchemaHistory[]
  Conversation       Conversation[]
  Message            Message[]
  PlaywrightTask     PlaywrightTask[]
  members            Member[] // Add reverse relation from Member
  Diff               Diff[]
  Plan               Plan[] // Add relation to Plan model
}

// New Member model based on IMemberFull interface
model Member {
  id             String    @id @default(uuid())
  username       String
  email          String    @unique
  provider       String?
  confirmed      Boolean
  blocked        Boolean
  role           Int // IMemberFull.role (number)
  memberSystemId Int       @unique @map("userId") // IMemberFull.userId. Unique identifier from the external member system.
  jsonData       Json      @map("json_data") // Stores the entire IMemberJsonData structure as JSON
  blockedExpire  DateTime? // IMemberFull.blockedExpire (string | null)
  blockedStart   DateTime? // IMemberFull.blockedStart (string | null)
  isPaid         Boolean   @map("PAID") // IMemberFull.PAID (boolean)
  createGroup    Boolean
  isEmployee     Boolean   @map("EMPLOYEE") // IMemberFull.EMPLOYEE (boolean)
  isOnline       Boolean   @map("ONLINE") // IMemberFull.ONLINE (boolean)
  memberType     String    @map("MEMBERTYPE") // IMemberFull.MEMBERTYPE (string)
  picture        String?   @map("PICTURE") // IMemberFull.PICTURE (string)
  adminUser      Json?     @map("admin_user") // IMemberFull.admin_user (any | null)
  createdAt      DateTime  @default(now()) @map("created_at") // IMemberFull.created_at (string)
  updatedAt      DateTime  @updatedAt @map("updated_at") // IMemberFull.updated_at (string)
  latString      String?   @map("LAT") // IMemberFull.LAT (string)
  lonString      String?   @map("LON") // IMemberFull.LON (string)
  userSetting    Json?     @map("usetting") // IMemberFull.usetting (any | null)
  terms          Json? // IMemberFull.terms (any | null)

  // Standard creator relation for audit trails
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([email])
  @@index([memberSystemId]) // Add index for the external system's user ID
  @@map("members") // Map table name to "members"
}

model Password {
  id          String   @id @default(uuid())
  hash        String
  createdById String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model Account {
  id                String    @id @default(uuid())
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt
  createdById       String
  createdBy         User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String    @id @default(uuid())
  sessionToken String    @unique
  expires      DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id])
}

model Documentation {
  id          String        @id @default(uuid())
  name        String
  content     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime?     @updatedAt
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  LlmResponse LlmResponse[]
  Plan        Plan[]
}

model File {
  id          String    @id @default(uuid())
  name        String
  content     String?
  path        String    @unique
  folderId    String?
  fileType    FileType  @default(OTHER)
  mimeType    String?
  size        BigInt?
  provider    String?
  url         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  metadata           Metadata[] // One file can have many metadata
  playlistMediaFiles PlaylistMediaFile[]

  song  Song?  @relation("SongFiles", fields: [songId], references: [id], onDelete: Cascade)
  video Video? @relation("VideoFiles", fields: [videoId], references: [id], onDelete: Cascade)

  songId  String?
  videoId String?
}

model Song {
  id        String         @id @default(uuid())
  title     String
  duration  Int
  year      Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  artistId  String
  artist    Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  albumId   String?
  album     Album?         @relation(fields: [albumId], references: [id], onDelete: Cascade)
  genres    Genre[]        @relation("SongToGenre")
  favorites FavoriteSong[]
  histories MusicHistory[]
  // Add the missing opposite relation field
  files     File[]         @relation("SongFiles")

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model Video {
  id          String          @id @default(uuid())
  title       String
  description String
  duration    Int
  year        Int
  rating      Float?
  director    String?
  cast        String[]
  resolution  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  genres      Genre[]         @relation("VideoToGenre")
  favorites   FavoriteVideo[]
  histories   VideoHistory[]
  // Add the missing opposite relation field
  files       File[]          @relation("VideoFiles")

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model PlaylistMediaFile {
  id          String   @id @default(uuid())
  playlistId  String
  fileId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Int      @default(0) // To allow custom ordering of tracks in a playlist
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([playlistId, fileId]) // A file can only be in a playlist once
  @@index([playlistId, order])
}

model Playlist {
  id          String   @id @default(uuid())
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  // Many-to-many relationship with File (MediaFile) through an explicit join table
  playlistMediaFiles PlaylistMediaFile[]
}

model Folder {
  id          String    @id @default(uuid())
  name        String
  path        String    @unique
  parentId    String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  files       File[]
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  parent      Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    Folder[]  @relation("FolderHierarchy")
}

model Project {
  id             String        @id @default(uuid())
  name           String
  description    String?
  path           String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  status         ProjectStatus @default(DEVELOPMENT)
  technologies   String[]
  versionControl String?
  repositoryUrl  String?
  lastOpenedAt   DateTime?
  ownerId        String?
  metadata       Json?
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
}

model Recording {
  id          String   @id @default(uuid())
  path        String
  type        String
  pid         String
  status      String
  data        Json
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([pid])
  @@index([status])
}

model GeminiRequest {
  id               String  @id @default(uuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id])
  conversationId   String?
  modelUsed        String
  prompt           String?
  projectStructure String?

  systemInstruction String?
  requestType       RequestType
  imageUrl          String?
  imageData         String?             @db.Text
  fileMimeType      String?
  fileData          String?             @db.Text
  files             Json?
  createdAt         DateTime            @default(now())
  geminiResponses   GeminiResponse[]
  SystemInstruction SystemInstruction[]

  @@index([userId])
  @@index([conversationId])
}

model GeminiResponse {
  id               String        @id @default(uuid())
  requestId        String
  request          GeminiRequest @relation(fields: [requestId], references: [id])
  title            String?
  responseText     String        @db.Text
  finishReason     String?
  safetyRatings    Json?
  tokenCount       Int?
  createdAt        DateTime      @default(now())
  projectRoot      String?
  playwrightOutput String?

  @@index([requestId])
}

model SystemInstruction {
  id          String        @id @default(uuid())
  requestId   String
  request     GeminiRequest @relation(fields: [requestId], references: [id])
  instruction String        @db.Text
  persona     String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([requestId])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  industry    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model Database {
  id               String   @id @default(uuid())
  name             String
  type             String
  host             String?
  port             Int?
  username         String?
  password         String?
  databaseName     String?
  connectionString String?
  default          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])
}

model Schema {
  id            String          @id @default(uuid())
  name          String
  schema        Json
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  LlmRequest    LlmRequest[]
  SchemaHistory SchemaHistory[]

  @@unique([name, createdById])
}

model SchemaHistory {
  id        String   @id @default(uuid())
  version   Int
  schema    Json
  createdAt DateTime @default(now())

  schemaId  String
  schemaRef Schema @relation(fields: [schemaId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@unique([schemaId, version])
}

model SchemaSubmission {
  id            String   @id @default(uuid())
  schemaName    String
  submittedById String
  data          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  schemaId      String
  submittedBy   User     @relation(fields: [submittedById], references: [id])

  @@index([schemaId])
  @@index([submittedById])
  @@index([createdAt])
}

model Module {
  id          String   @id @default(uuid())
  name        String
  category    String
  parentId    String?
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([name])
  @@index([parentId])
}

model Form {
  id          String       @id @default(uuid())
  name        String
  fields      Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  submissions Submission[]
}

model Submission {
  id          String   @id @default(uuid())
  data        Json
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  formId      String?
  createdBy   User     @relation(fields: [createdById], references: [id])
  Form        Form?    @relation(fields: [formId], references: [id])
}

model Icon {
  id        String   @id @default(uuid())
  prefix    String
  name      String
  path      String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@unique([prefix, name])
}

model Logs {
  id        String   @id @default(uuid())
  type      String
  level     String   @default("INFO")
  data      Json
  tags      String[] @default([])
  createdAt DateTime @default(now())

  @@index([type])
  @@index([level])
  @@index([createdAt])
}

model Metadata {
  id        String       @id @default(uuid())
  type      MetadataType
  data      Json
  tags      String[]     @default([])
  createdAt DateTime     @default(now())

  fileId      String
  file        File    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  @@index([fileId])
  @@index([type])
  @@index([createdAt])
}

model TerminalCommand {
  id          String    @id @default(uuid())
  command     String    @db.Text
  description String?
  output      String?   @db.Text
  tags        String[]  @default([])
  isFavorite  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([createdAt])
  @@index([isFavorite])
}

model TerminalSession {
  id             String                @id @default(uuid())
  name           String?
  createdAt      DateTime              @default(now())
  startedAt      DateTime              @default(now())
  endedAt        DateTime?
  ipAddress      String?
  userAgent      String?
  clientInfo     Json?
  status         TerminalSessionStatus @default(ACTIVE)
  createdById    String
  createdBy      User                  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  commandHistory CommandHistory[]

  @@index([createdById])
  @@index([startedAt])
  @@index([status])
}

model CommandHistory {
  id               String   @id @default(uuid())
  command          String   @db.Text
  executedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  status           String?
  exitCode         Int?
  output           String?
  errorOutput      String?
  workingDirectory String?
  durationMs       Int?
  shellType        String?

  terminalSessionId String
  terminalSession   TerminalSession @relation(fields: [terminalSessionId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([executedAt])
  @@index([status])
  @@index([terminalSessionId])
}

// New models for music and video functionality
model Artist {
  id        String   @id @default(uuid())
  name      String
  bio       String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  songs  Song[]
  albums Album[]

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model Album {
  id          String    @id @default(uuid())
  title       String
  releaseDate DateTime?
  coverArt    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs    Song[]

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Relationships
  songs  Song[]  @relation("SongToGenre")
  videos Video[] @relation("VideoToGenre")
}

model FavoriteSong {
  id        String   @id @default(uuid())
  songId    String
  createdAt DateTime @default(now())

  // Relationships
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  song        Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([createdById, songId])
}

model FavoriteVideo {
  id String @id @default(uuid())

  videoId   String
  createdAt DateTime @default(now())

  // Relationships
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  video       Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([createdById, videoId])
}

model MusicHistory {
  id          String   @id @default(uuid())
  playedAt    DateTime @default(now())
  progress    Int? // in seconds
  songId      String
  createdAt   DateTime @default(now())
  // Relationships
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([createdById, playedAt])
}

model VideoHistory {
  id       String   @id @default(uuid())
  playedAt DateTime @default(now())
  progress Int? // in minutes

  videoId     String
  createdAt   DateTime @default(now())
  // Relationships
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([createdById, playedAt])
}

model LlmRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userPrompt             String
  projectRoot            String
  scanPaths              String[]
  additionalInstructions String
  expectedOutputFormat   String
  requestType            RequestType

  schemaId      String?
  schema        Schema? @relation(fields: [schemaId], references: [id])
  schemaVersion Int?
  createdById   String
  createdBy     User    @relation(fields: [createdById], references: [id])

  // relations
  response LlmResponse?
  Plan     Plan[]
}

model LlmResponse {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title          String
  summary        String?
  thoughtProcess String?
  projectRoot    String
  requestId      String     @unique
  request        LlmRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  changes ProposedFileChange[]

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  documentation   String?        @db.Text // Store documentation content directly
  gitInstructions String[]
  Documentation   Documentation? @relation(fields: [documentationId], references: [id])
  documentationId String?
}

model Diff {
  id                   String             @id @default(uuid())
  filePath             String
  diff                 String
  createdAt            DateTime           @default(now())
  proposedFileChangeId String             @unique
  proposedFileChange   ProposedFileChange @relation(fields: [proposedFileChangeId], references: [id], onDelete: Cascade)
  createdById          String
  createdBy            User               @relation(fields: [createdById], references: [id])

  @@index([filePath])
}

model ProposedFileChange {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  filePath    String
  action      FileAction
  newContent  String?
  reason      String?
  responseId  String
  response    LlmResponse @relation(fields: [responseId], references: [id])
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])

  // one-to-one relation with Diff
  diff Diff?
}

model ExecutionSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  planId  String
  success Boolean
  error   String?

  // git commit hash or diff for rollback
  commitHash String?

  appliedChanges Json?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
}

// New Plan model for persistence in PlannerService
model Plan {
  id                     String         @id @default(uuid())
  title                  String
  summary                String?
  thoughtProcess         String?
  documentation          Documentation? @relation(fields: [documentationId], references: [id])
  documentationId        String?
  gitInstructions        String[]       @default([])
  llmRequest             LlmRequest?    @relation(fields: [llmRequestId], references: [id])
  llmRequestId           String?
  llmInput               Json? // Stores the input that generated this plan
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  lastExecutionStatus    String? // e.g., 'SUCCESS', 'FAILURE'
  lastExecutionError     String?        @db.Text
  lastExecutionTimestamp DateTime?

  // Relation to User
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  // Relation to FileChanges (One-to-Many)
  changes FileChange[]

  @@index([createdById])
  @@index([createdAt])
}

// New FileChange model for persistence in PlannerService (related to Plan)
model FileChange {
  id         String     @id @default(uuid())
  filePath   String
  action     FileAction
  newContent String?    @db.Text
  diff       String?    @db.Text
  reason     String?
  createdAt  DateTime   @default(now())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  // Optional: createdBy if you want to track who approved/modified a change within a plan
  // createdById String?
  // createdBy   User?        @relation(fields: [createdById], references: [id])

  @@index([planId])
  @@index([filePath])
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Conversation {
  id          String             @id @default(uuid())
  title       String
  status      ConversationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id])
  metadata    Json? // For storing system instructions, model parameters, etc.

  // Relation to Message (One-to-Many)
  messages Message[]

  @@index([createdById])
  @@index([status])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  sender         Sender // Uses the existing Sender enum (USER, AI, BOT)
  content        String    @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt
  createdById    String
  createdBy      User      @relation(fields: [createdById], references: [id])
  metadata       Json? // For source links, file references, etc.

  // Relation back to Conversation
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdById])
}

// Playwright Task Model
model PlaywrightTask {
  id             String               @id @default(uuid())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdById    String
  createdBy      User                 @relation(fields: [createdById], references: [id])
  url            String
  actionType     PlaywrightActionType
  llmInstruction String?              @db.Text
  status         PlaywrightTaskStatus @default(PENDING)
  errorMessage   String?              @db.Text
  outputJson     Json? // Stores the detailed output (scraped text, screenshot base64, video path, gemini analysis)
  durationMs     Int?
  browserType    String?
  headless       Boolean?

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

enum Role {
  ADMIN
  USER
  MANAGER
  DEVELOPER
}

enum Sender {
  USER
