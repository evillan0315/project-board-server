// Playwright Task Model
model PlaywrightTask {
  id               String                 @id @default(uuid())
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdById      String                 // Links to the User who initiated the task
  createdBy        User                   @relation(fields: [createdById], references: [id])
  url              String                 // The URL the Playwright task was performed on
  actionType       PlaywrightActionType   // Type of Playwright action (e.g., SCRAPE, SCREENSHOT)
  llmInstruction   String?                @db.Text // Original LLM instruction if any
  status           PlaywrightTaskStatus   @default(PENDING) // Current status of the task
  errorMessage     String?                @db.Text // Error message if the task failed
  outputJson       Json?                  // Stores the detailed output (scrapedText, screenshotBase64, recordedVideoPath, geminiAnalysis)
  durationMs       Int?                   // Duration of the task in milliseconds
  browserType      String?                // Which browser was used (e.g., chromium, firefox)
  headless         Boolean?               // Whether the browser ran in headless mode

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

enum PlaywrightActionType {
  SCRAPE
  SCREENSHOT
  RECORD_SCREEN
  PERFORM_MULTIPLE_TASKS
  CUSTOM_NAVIGATION
}

enum PlaywrightTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}
